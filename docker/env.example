# Copy to .env next to docker-compose.yml and adjust. Never commit .env.

# ---- HoneyFactory ----
# 1 = demo mode (demo accounts with password honey123, demo class). docker/compose.production.yml sets 0.
VF_DEMO=1
# Server language (en or zh-CN): default for requests without a language, and the language of the running plants
# (station names, events, tag descriptions). The demo plant is written in this language on first start.
VF_LANG=en
# selfhost (plants run on this server) or saas (accounts, classes and courses only; plants run in the desktop clients).
VF_MODE=selfhost
# Time zone of the container (shifts, reports, timestamps). Example: Europe/Berlin, Asia/Shanghai.
TZ=UTC
# Image to run. Default honeyfactory:local is built from this checkout; or use a published image, e.g.
# HONEYFACTORY_IMAGE=ghcr.io/honeymeta/honeyfactory:latest
HONEYFACTORY_IMAGE=honeyfactory:local

# ---- Ports on the host ----
VF_PORT=8800
VF_OPCUA_PORT=4840
VF_MQTT_PORT=1883
# A range of 10 ports (the container side is fixed at 5020-5029).
VF_MODBUS_PORTS=5020-5029

# ---- Teaching ----
# Student sandboxes running at the same time, and idle seconds before a sandbox sleeps.
VF_SANDBOX_MAX_ACTIVE=40
VF_SANDBOX_IDLE_S=600

# ---- Behind a TLS reverse proxy ----
# 1 = treat every request as HTTPS (Secure cookies) when the proxy does not send X-Forwarded-Proto.
VF_HTTPS=0

# ---- AI (OpenAI-compatible chat completions endpoint) ----
# No defaults. The assistant, the AI tutor and AI grading call a model only when all three are set; otherwise they
# are off and the tutor falls back to the built-in hints.
VF_LLM_BASE_URL=
VF_LLM_API_KEY=
VF_LLM_MODEL=
