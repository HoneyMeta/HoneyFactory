 "reference": {
  "st": {
   "id": "reference",
   "name": "参考答案",
   "lang": "ST",
   "vars": [],
   "source": "PROGRAM SortColor\nVAR\n    RUN : BOOL;\n    IS_GREEN : BOOL;      (* 最近一次视觉识别是绿色 *)\n    PUSH : BOOL;          (* 推杆动作中 *)\n    TRIG : R_TRIG;        (* S1 上升沿 *)\nEND_VAR\n    (* 启停：启动按钮自锁，停止按钮和急停按钮都是常闭触点（没按时为 TRUE） *)\n    RUN := (START OR RUN) AND STOP AND ESTOP;\n    LAMP_RUN := RUN;\n    C1_FWD := RUN;\n    (* 零件经过视觉时锁存颜色 *)\n    IF V1_DETECT THEN\n        IS_GREEN := (V1_CODE = 2);\n    END_IF;\n    (* 零件到推杆前：绿色就推 *)\n    TRIG(CLK := S1);\n    IF TRIG.Q AND IS_GREEN AND RUN THEN\n        PUSH := TRUE;\n        IS_GREEN := FALSE;\n    END_IF;\n    IF P1_FRONT OR NOT RUN THEN\n        PUSH := FALSE;\n    END_IF;\n    P1_EXTEND := PUSH;\nEND_PROGRAM\n"
  },
