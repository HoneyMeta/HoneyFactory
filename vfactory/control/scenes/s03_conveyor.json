   "source": "PROGRAM Conveyor\nVAR\n    RUN : BOOL;     (* 运行标志 *)\nEND_VAR\n    (* 启停：启动按钮自锁，停止按钮和急停按钮都是常闭触点（没按时为 TRUE） *)\n    RUN := (START OR RUN) AND STOP AND ESTOP;\n    LAMP_RUN := RUN;\n    C1_FWD := RUN;\n    LAMP_STOP := NOT RUN;\nEND_PROGRAM\n"
